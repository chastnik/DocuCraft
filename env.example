# DocuCraft Environment Variables Example
# Скопируйте этот файл в .env и заполните реальными значениями
# cp env.example .env

# ============================================
# Application Settings
# ============================================
APP_NAME=DocuCraft
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Database Configuration
# ============================================
# PostgreSQL database URL (async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/docucraft

# PostgreSQL database URL (sync) - для Alembic и других синхронных операций
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/docucraft

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# GitHub OAuth Integration (Global)
# ============================================
# Эти настройки используются только для глобальной OAuth авторизации через GitHub
# Для интеграции с Git репозиториями используйте настройки на уровне проекта
# Регистрация приложения: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ВАЖНО: Git настройки (репозитории, webhook secrets, access tokens) 
# настраиваются индивидуально для каждого проекта через API:
# GET/PUT /api/v1/projects/{project_id}/git-config
# Поддерживаемые провайдеры: github, gitlab, gitea, custom

# ============================================
# AI Provider Configuration
# ============================================
# Выберите провайдера: "openai" или "anthropic"
# ПРИМЕЧАНИЕ: Настройки AI можно также управлять через панель администрирования
# (требуется superuser). Настройки из БД имеют приоритет над .env файлом.
AI_PROVIDER=openai

# OpenAI API Key (если используете OpenAI)
# Используется как fallback, если настройки не заданы в БД
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (если используете Anthropic)
# Используется как fallback, если настройки не заданы в БД
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ============================================
# CORS Configuration
# ============================================
# Разрешенные origins (через запятую для нескольких)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# File Storage Configuration
# ============================================
# Тип хранилища: "local" или "s3"
STORAGE_TYPE=local

# Путь для локального хранилища (если STORAGE_TYPE=local)
STORAGE_PATH=./storage

# AWS S3 Configuration (если STORAGE_TYPE=s3)
S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

